#!/usr/bin/env bash
# wallpaper - manage linux-wallpaperengine wallpapers
#
#   wallpaper set <id|name> [--clone|--stretch]
#   wallpaper select [--clone|--stretch]
#   wallpaper get [id|name]
#   wallpaper list | ls
#   wallpaper props [id|name]
#   wallpaper restore        (used at login)
#   wallpaper stop

set -u

STEAM_LIBS=(/mnt/storage/SteamLibrary "$HOME/.local/share/Steam")
STATE_DIR="$HOME/.config/wallpaper"
STATE_FILE="$STATE_DIR/state"
LOG_FILE="$HOME/.cache/wallpaper.log"
FPS=30
PROC_PATTERN="(^|/)linux-wallpaperengine( |$)"
PROPS_DIR="$STATE_DIR/props"
APPLY_TOKEN="$STATE_DIR/.apply"
SELF=$(realpath "$0")

die() { echo "wallpaper: $*" >&2; exit 1; }

assets_dir() {
    local lib
    for lib in "${STEAM_LIBS[@]}"; do
        [[ -d $lib/steamapps/common/wallpaper_engine/assets ]] && { echo "$lib/steamapps/common/wallpaper_engine/assets"; return; }
    done
    die "Wallpaper Engine assets not found"
}

# Prints "id<TAB>type<TAB>title<TAB>path" for every downloaded wallpaper
catalog() {
    local lib dir
    for lib in "${STEAM_LIBS[@]}"; do
        for dir in "$lib"/steamapps/workshop/content/431960/*/; do
            [[ -f $dir/project.json ]] || continue
            jq -r --arg id "$(basename "$dir")" --arg path "${dir%/}" \
                '[$id, (.type // "?" | ascii_downcase), (.title // "?"), $path] | @tsv' "$dir/project.json" 2>/dev/null
        done
    done
}

# Resolves an id or (case-insensitive, exact then partial) name to a catalog line
resolve() {
    local query=$1 cat matches
    cat=$(catalog)
    if [[ $query =~ ^[0-9]+$ ]]; then
        matches=$(awk -F'\t' -v q="$query" '$1 == q' <<<"$cat")
    else
        matches=$(awk -F'\t' -v q="${query,,}" 'tolower($3) == q' <<<"$cat")
        [[ -z $matches ]] && matches=$(awk -F'\t' -v q="${query,,}" 'index(tolower($3), q)' <<<"$cat")
    fi
    [[ -z $matches ]] && die "no wallpaper matches '$query'"
    if (( $(wc -l <<<"$matches") > 1 )); then
        echo "wallpaper: '$query' matches several wallpapers:" >&2
        cut -f1,3 <<<"$matches" | column -t -s $'\t' >&2
        exit 1
    fi
    echo "$matches"
}

# Monitors ordered left to right
monitors() {
    hyprctl monitors -j | jq -r 'sort_by(.x) | .[].name'
}

load_state() {
    ID="" MODE="clone"
    [[ -f $STATE_FILE ]] && source "$STATE_FILE"
}

save_state() {
    mkdir -p "$STATE_DIR"
    printf 'ID=%q\nMODE=%q\n' "$1" "$2" >"$STATE_FILE"
}

launch() {
    local path=$1 mode=$2 mon
    local args=(--assets-dir "$(assets_dir)" --silent --fps "$FPS")
    mapfile -t mons < <(monitors)
    (( ${#mons[@]} )) || die "no monitors found (is Hyprland running?)"
    if [[ $mode == stretch ]]; then
        args+=(--screen-span "$(IFS=,; echo "${mons[*]}")" --bg "$path" --scaling fill)
    else
        for mon in "${mons[@]}"; do
            args+=(--screen-root "$mon" --bg "$path" --scaling fill)
        done
    fi
    local prop
    while IFS= read -r prop; do
        [[ -n $prop ]] && args+=(--set-property "$prop")
    done < <(jq -r 'to_entries[] | "\(.key)=\(.value)"' <<<"$(overrides "$(basename "$path")")")
    pkill -f "$PROC_PATTERN" && sleep 0.3
    mkdir -p "$(dirname "$LOG_FILE")"
    setsid -f linux-wallpaperengine "${args[@]}" >"$LOG_FILE" 2>&1
}

# Parses --clone/--stretch out of the arguments; leftover words go in REST
parse_mode() {
    load_state
    MODE_ARG=$MODE
    REST=()
    local a
    for a in "$@"; do
        case $a in
            -clone|--clone) MODE_ARG=clone ;;
            -stretch|--stretch) MODE_ARG=stretch ;;
            *) REST+=("$a") ;;
        esac
    done
}

apply() {
    local line=$1 mode=$2 id type title path
    IFS=$'\t' read -r id type title path <<<"$line"
    launch "$path" "$mode"
    save_state "$id" "$mode"
    echo "Set \"$title\" ($id, $type) [$mode]"
}

cmd_set() {
    parse_mode "$@"
    (( ${#REST[@]} )) || die "usage: wallpaper set <id|name> [--clone|--stretch]"
    apply "$(resolve "${REST[*]}")" "$MODE_ARG"
}

cmd_select() {
    parse_mode "$@"
    local line
    line=$(catalog | sort -t$'\t' -k3,3f | fzf --delimiter=$'\t' --with-nth=3,2,1 \
        --prompt="wallpaper [$MODE_ARG]> " --height=60% --reverse \
        --bind=resize:refresh-preview --with-shell="bash -c" \
        --preview="$(printf %q "$(realpath "$0")") _preview {4} {3}") || exit 0
    apply "$line" "$MODE_ARG"
}

# fzf preview: kitty's unicode placeholders keep images inside text cells so
# fzf can clear them on redraw/resize; chafa is the fallback elsewhere
cmd_preview() {
    local dir=$1 title=$2 img
    img=$(compgen -G "$dir/preview.*" | head -1)
    [[ -n $img ]] || { echo "$title"; return; }
    local dim="${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}"
    if [[ -n ${KITTY_WINDOW_ID:-} ]] && command -v kitten >/dev/null; then
        kitten icat --clear --transfer-mode=memory --unicode-placeholder --stdin=no \
            --place="$dim@0x0" "$img" | sed '$d' | sed $'$s/$/\e[m/'
    else
        chafa --animate=off --size="$dim" "$img" 2>/dev/null || echo "$title"
    fi
}

cmd_get() {
    local id type title path
    if (( $# == 0 )); then
        load_state
        [[ -n $ID ]] || die "no wallpaper set yet"
        IFS=$'\t' read -r id type title path <<<"$(resolve "$ID")"
        local running="stopped"
        pgrep -f "$PROC_PATTERN" >/dev/null && running="running"
        echo "$title ($id, $type) [$MODE, $running]"
        return
    fi
    IFS=$'\t' read -r id type title path <<<"$(resolve "$*")"
    if [[ $1 =~ ^[0-9]+$ ]]; then echo "$title"; else echo "$id"; fi
}

cmd_list() {
    load_state
    catalog | sort -t$'\t' -k3,3f | awk -F'\t' -v cur="$ID" \
        '{ printf "%s %-12s %-7s %s\n", ($1 == cur ? "*" : " "), $1, $2, $3 }'
}

cmd_restore() {
    load_state
    [[ -n $ID ]] || exit 0
    # Wait for Hyprland to report monitors at login
    for _ in {1..20}; do
        [[ -n $(monitors 2>/dev/null) ]] && break
        sleep 0.5
    done
    local line
    line=$(resolve "$ID") || exit 1
    launch "$(cut -f4 <<<"$line")" "$MODE"
}

# --- properties -------------------------------------------------------------

# jq helpers over a wallpaper's project.json. $o holds the saved overrides,
# $k the property being changed and $step the direction (+, -, toggle).
PROPS_JQ='
def cur: $o[.key] // (.value.value | if type == "boolean" then (if . then "1" else "0" end) else tostring end);
def norm: tostring | gsub("^[\"'"'"' ]+|[\"'"'"' ]+$"; "") | if . == "true" then "1" elif . == "false" then "0" else . end;
def title: (.value.text // "")
    | if startswith("ui_browse_properties_") then .[21:] | gsub("_"; " ") else . end
    | gsub("<[^>]*>"; "") | gsub("[‎ㅤ ]"; " ") | gsub("\\s+"; " ") | gsub("^ | $"; "");
def prec: .precision // (if (.step // 1) < 1 then 2 else 0 end);
def fmt($p): if $p == 0 then round | tostring else (. * pow(10; $p) | round) / pow(10; $p) | tostring end;
def rgb: split(" ") | map(select(. != "") | tonumber * 255 | round | [., 0] | max | [., 255] | min) | .[0:3];
def hex: map([(. / 16 | floor), (. % 16)] | map("0123456789abcdef"[.:. + 1]) | join("")) | join("");
def repeat($s; $n): [range($n)] | map($s) | join("");
def props: (.general.properties // {}) | to_entries
    | map(select((.value.type | IN("bool", "slider", "combo", "color")) and .key != "schemecolor"))
    | sort_by(.value.order // .value.index // 0);
# Hides properties whose "a.value == x && b.value" style condition is false
def clause($all): capture("^\\s*(?<k>[A-Za-z0-9_]+)\\.value\\s*((?<op>==|!=)\\s*(?<v>.+?))?\\s*$")? // null
    | . as $m | ($all | map(select(.key == $m.k)) | .[0]) as $p
    | if $m == null or $p == null then true
      elif $m.op == null then ($p | cur | norm) | . != "0" and . != ""
      elif $m.op == "==" then ($p | cur | norm) == ($m.v | norm)
      else ($p | cur | norm) != ($m.v | norm) end;
def visible($all): (.value.condition // "") as $c
    | if $c == "" or ($c | test("\\|\\|")) then true
      else $c | split("&&") | all(clause($all)) end;
def rows: ((.general.properties // {}) | to_entries) as $all | props[] | select(visible($all))
    | .key as $key | .value as $d | cur as $v
    | ((title | if . == "" then null else . end) // $key) as $name
    | (if $d.condition then "  " + $name else $name end) as $l
    | (if $d.type == "bool" then (if ($v | norm) == "1" then "[x]" else "[ ]" end)
       elif $d.type == "slider" then
         ($v | tonumber) as $n | ($d.min // 0) as $mn | ($d.max // 1) as $mx
         | (if $mx > $mn then ($n - $mn) / ($mx - $mn) * 20 | round else 0 end | [., 0] | max | [., 20] | min) as $f
         | "◀ \(repeat("█"; $f))\(repeat("░"; 20 - $f)) ▶ \($n | fmt($d | prec))"
       elif $d.type == "combo" then
         "◀ \(($d.options // []) | map(select((.value | tostring) == $v)) | .[0].label // $v) ▶"
       else ($v | rgb) as $c | "\u001b[48;2;\($c[0]);\($c[1]);\($c[2])m      \u001b[0m #\($c | hex)"
       end) as $disp
    | ($l | .[0:38]) as $l
    | [$key, $d.type, $l + repeat(" "; 40 - ($l | length)) + $disp + (if $o | has($key) then "  *" else "" end)]
    | @tsv;
def adjust: props[] | select(.key == $k) | .value as $d | cur as $v
    | if $d.type == "bool" then
        if $step == "toggle" then (if ($v | norm) == "1" then "0" else "1" end)
        elif $step == "+" then "1" else "0" end
      elif $d.type == "slider" then
        ($v | tonumber) + (if $step == "-" then -1 else 1 end) * ($d.step // 1)
        | [., $d.min // 0] | max | [., $d.max // 1] | min | fmt($d | prec)
      elif $d.type == "combo" then
        (($d.options // []) | map(.value | tostring)) as $ov
        | if ($ov | length) == 0 then empty
          else $ov[((($ov | index($v)) // 0) + (if $step == "-" then -1 else 1 end)) % ($ov | length)] end
      else empty end;
def info: props[] | select(.key == $k) | .value as $d | cur as $v
    | [$d.type, $v, ($d.min // 0), ($d.max // 1), (if $d.type == "color" then $v | rgb | hex else "" end)] | @tsv;
'

overrides() {
    local f="$PROPS_DIR/$1.json"
    if [[ -s $f ]]; then cat "$f"; else echo '{}'; fi
}

# prop_jq <id> <dir> <filter> [key] [step]
prop_jq() {
    jq -r --argjson o "$(overrides "$1")" --arg k "${4:-}" --arg step "${5:-}" \
        "$PROPS_JQ $3" "$2/project.json"
}

# set_override <id> <key> [value]   (no value = reset to default)
set_override() {
    local f="$PROPS_DIR/$1.json" new
    mkdir -p "$PROPS_DIR"
    if (( $# == 3 )); then
        new=$(overrides "$1" | jq --arg k "$2" --arg v "$3" '.[$k] = $v')
    else
        new=$(overrides "$1" | jq --arg k "$2" 'del(.[$k])')
    fi
    echo "$new" >"$f"
}

# Restarts the wallpaper shortly after the last change, if it is the current one
schedule_apply() {
    load_state
    [[ $1 == "$ID" ]] || return 0
    local tok=$EPOCHREALTIME
    mkdir -p "$STATE_DIR"
    echo "$tok" >"$APPLY_TOKEN"
    setsid -f bash -c 'sleep 0.7; [[ $(cat "$1") == "$2" ]] && exec "$3" restore' \
        _ "$APPLY_TOKEN" "$tok" "$SELF" >/dev/null 2>&1
}

# Prompts for an exact slider value or a hex color
prop_edit() {
    local id=$1 dir=$2 key=$3 type val min max hex input
    IFS=$'\t' read -r type val min max hex < <(prop_jq "$id" "$dir" info "$key")
    exec </dev/tty >/dev/tty 2>&1
    case $type in
        slider)
            read -r -e -p "Value ($min to $max): " -i "$val" input || return
            [[ $input =~ ^-?[0-9]*\.?[0-9]+$ ]] || return
            set_override "$id" "$key" "$(awk -v x="$input" -v a="$min" -v b="$max" \
                'BEGIN { x += 0; if (x < a) x = a; if (x > b) x = b; print x }')"
            ;;
        color)
            read -r -e -p "Hex color: " -i "#$hex" input || return
            input=${input#\#}
            [[ $input =~ ^[0-9a-fA-F]{6}$ ]] || return
            set_override "$id" "$key" "$(awk -v r=$((16#${input:0:2})) -v g=$((16#${input:2:2})) -v b=$((16#${input:4:2})) \
                'BEGIN { printf "%.4f %.4f %.4f", r / 255, g / 255, b / 255 }')"
            ;;
        bool|combo) set_override "$id" "$key" "$(prop_jq "$id" "$dir" adjust "$key" toggle)" ;;
        *) return ;;
    esac
}

# Internal commands called by the fzf bindings in cmd_props
cmd_prop() {
    local id=$1 dir=$2 action=$3 key=${4:-} v
    case $action in
        rows) prop_jq "$id" "$dir" rows ;;
        step)
            v=$(prop_jq "$id" "$dir" adjust "$key" "$5")
            [[ -n $v ]] || return 0
            set_override "$id" "$key" "$v"
            schedule_apply "$id"
            ;;
        edit) prop_edit "$id" "$dir" "$key" && schedule_apply "$id" ;;
        reset) set_override "$id" "$key"; schedule_apply "$id" ;;
    esac
}

cmd_props() {
    local line id type title path
    if (( $# )); then
        line=$(resolve "$*")
    else
        load_state
        [[ -n $ID ]] || die "no wallpaper set yet"
        line=$(resolve "$ID")
    fi
    IFS=$'\t' read -r id type title path <<<"$line"
    [[ -n $(prop_jq "$id" "$path" rows) ]] || { echo "\"$title\" has no adjustable properties"; return; }

    local p="$(printf %q "$SELF") _prop $id $(printf %q "$path")"
    prop_jq "$id" "$path" rows | fzf --ansi --no-input --reverse --height=80% \
        --delimiter=$'\t' --with-nth=3 --id-nth=1 --track \
        --border=rounded --border-label=" $title " \
        --header='↑↓ move  ←→ adjust  enter toggle/edit  r reset  esc quit  (* = changed)' \
        --with-shell="bash -c" \
        --bind="right:execute-silent($p step {1} +)+reload($p rows)" \
        --bind="left:execute-silent($p step {1} -)+reload($p rows)" \
        --bind="enter:transform:[[ {2} == slider || {2} == color ]] && echo \"execute($p edit {1})+reload($p rows)\" || echo \"execute-silent($p step {1} toggle)+reload($p rows)\"" \
        --bind="r:execute-silent($p reset {1})+reload($p rows)" \
        --bind="q:abort" >/dev/null || true
}

usage() {
    cat <<EOF
usage: wallpaper <command> [args]

  set <id|name> [--stretch|--clone]  set a wallpaper (name can be partial)
  select [--stretch|--clone]         pick a wallpaper with arrow keys + Enter
  get                                show the current wallpaper
  get <id|name>                      id -> name, or name -> id
  list, ls                           list downloaded wallpapers (* = current)
  props [id|name]                    edit wallpaper settings (default: current)
  restore                            start the saved wallpaper (runs at login)
  stop                               stop the wallpaper

--clone puts the wallpaper on every monitor, --stretch spans it across all
of them. The last mode used is remembered.
EOF
}

case ${1:-} in
    set) shift; cmd_set "$@" ;;
    select) shift; cmd_select "$@" ;;
    get) shift; cmd_get "$@" ;;
    list|ls) cmd_list ;;
    props) shift; cmd_props "$@" ;;
    _prop) shift; cmd_prop "$@" ;;
    restore) cmd_restore ;;
    _preview) shift; cmd_preview "$@" ;;
    stop) pkill -f "$PROC_PATTERN"; echo "Stopped" ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command '$1' (try: wallpaper help)" ;;
esac
